  _values:
  - E
  - 0
  - "\u041F\u043E\u0432\u044B\u0448\u0435\u043D\u0438\u0435 \u0423\u0440\u043E\u043D\u0430"
  - "\u041F\u043E\u0432\u044B\u0448\u0435\u043D\u0438\u0435 \u041A\u0440\u0438\u0442\u0430"
  - "\u0423\u043C\u0435\u043D\u044C\u0448\u0435\u043D\u0438\u0435 \u041A\u0414 \u0434\u044D\u0448\u0430"
  - "\u0423\u043C\u0435\u043D\u044C\u0448\u0435\u043D\u0438\u0435 \u041A\u0414"
  - "\u041F\u043E\u0432\u044B\u0448\u0435\u043D\u0438\u0435 \u0425\u041F"
  - "\u041F\u043E\u0432\u044B\u0448\u0435\u043D\u0438\u0435 \u0421\u043A\u043E\u0440\u043E\u0441\u0442\u0438"
  - "\u041D\u0430\u0436\u043C\u0438 \u043D\u0430 \u043F\u0430\u043D\u0435\u043B\u044C
    \u0438 \u043D\u0430\u0432\u0435\u0434\u0438 \u043A\u0443\u0440\u0441\u043E\u0440
    \u043D\u0430 \u043A\u0430\u0440\u0442\u0443, \u0447\u0442\u043E\u0431\u044B \u0443\u0432\u0438\u0434\u0435\u0442\u044C
    \u0435\u0451 \u043E\u043F\u0438\u0441\u0430\u043D\u0438\u0435 (\u0435\u0441\u043B\u0438
    \u043E\u043D\u043E \u0435\u0441\u0442\u044C)"
  - "\u041F\u043E\u043C\u0435\u043D\u044F\u0442\u044C"
  - "\u0422\u044B \u043C\u043E\u0436\u0435\u0448\u044C \u043F\u043E\u043C\u0435\u043D\u044F\u0442\u044C
    \u0423\u0440\u043E\u043D \u0412\u0440\u0430\u0433\u043E\u0432"
  - "\u0422\u044B \u043C\u043E\u0436\u0435\u0448\u044C \u043F\u043E\u043C\u0435\u043D\u044F\u0442\u044C
    \u041A\u0440\u0438\u0442 \u0448\u0430\u043D\u0441 \u0412\u0440\u0430\u0433\u043E\u0432"
  - "\u0422\u044B \u043C\u043E\u0436\u0435\u0448\u044C \u043F\u043E\u043C\u0435\u043D\u044F\u0442\u044C
    \u041A\u043E\u043B-\u0432\u043E \u0412\u0440\u0430\u0433\u043E\u0432"
  - "\u0422\u044B \u043C\u043E\u0436\u0435\u0448\u044C \u043F\u043E\u043C\u0435\u043D\u044F\u0442\u044C
    \u0425\u041F \u0412\u0440\u0430\u0433\u043E\u0432"
  - "\u0422\u044B \u043C\u043E\u0436\u0435\u0448\u044C \u043F\u043E\u043C\u0435\u043D\u044F\u0442\u044C
    \u0421\u043A\u043E\u0440\u043E\u0441\u0442\u044C \u0412\u0440\u0430\u0433\u043E\u0432"
  - "\u0422\u044B \u043C\u0435\u043D\u044F\u0435\u0448\u044C \u043F\u0430\u0440\u0430\u043C\u0435\u0442\u0440\u044B
    \u0432\u0440\u0430\u0433\u043E\u0432, \u043D\u043E \u043E\u043D\u0438 \u043C\u043E\u0433\u0443\u0442
    \u043A\u0430\u043A \u043F\u043E\u0432\u044B\u0441\u0438\u0442\u044C\u0441\u044F,
    \u0442\u0430\u043A \u0438 \u043F\u043E\u043D\u0438\u0437\u0438\u0442\u044C\u0441\u044F"
  - "\u0421\u0447\u0430\u0441\u0442\u043B\u0438\u0432\u044B\u0439 \u0448\u0430\u043D\u0441"
  - "\u0412\u043E\u0437\u043E\u0431\u043D\u043E\u0432\u0438\u0442\u044C"
